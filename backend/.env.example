NODE_ENV=development
PORT=5000
LOG_LEVEL=info
TRUST_PROXY=0

# Real database (development / production). Special characters in the password must be URL-encoded.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pehanly?retryWrites=true&w=majority

# Test database. REQUIRED by `npm test`. Tests never use MONGODB_URI.
# The database name must contain "test" and must differ from the one above.
MONGODB_TEST_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pehanly_test?retryWrites=true&w=majority

MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=20
# MONGO_AUTO_INDEX=true
# Startup only: retry a transient first-connection failure (DNS / network, e.g. "querySrv ECONNREFUSED")
# instead of exiting, so the frontend proxy does not report ECONNREFUSED. 0 = no retries.
MONGO_CONNECT_RETRIES=4
MONGO_CONNECT_RETRY_DELAY_MS=3000

# Browser origins allowed to call the API with cookies. EXACT scheme + host + port, comma separated, no path,
# no trailing slash, no quotes. Every frontend you run needs an entry:
#   Admin Dashboard -> http://localhost:3000     Customer Website -> http://localhost:3001
# A write request (register, login, ...) from any other origin is answered 403 CORS_ORIGIN_NOT_ALLOWED.
# In development, http://127.0.0.1:PORT and http://[::1]:PORT are also accepted for a listed localhost origin.
# Restart the API after changing this. A CORS_ORIGINS set in your shell/OS environment overrides this file
# (the API prints the effective origins at startup: look for "corsOrigins").
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Public URL of the storefront (used in password-reset links).
CLIENT_URL=http://localhost:3001

BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SHUTDOWN_TIMEOUT_MS=10000

# Minimum 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-value
SESSION_DAYS=7
# Session length when the user ticks "Remember me" (login `rememberMe: true`)
REMEMBER_ME_DAYS=30
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
PASSWORD_RESET_MINUTES=30

# Admin push notifications (optional; set all three or none)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Cloudinary (set all three or none; REQUIRED when NODE_ENV=production)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# JazzCash hosted checkout (set all of MERCHANT_ID, PASSWORD, INTEGRITY_SALT,
# RETURN_URL or none). SANDBOX ONLY until verified against the real gateway.
# JAZZCASH_ENV=live additionally requires JAZZCASH_CHECKOUT_URL.
# RETURN_URL must be the public URL of POST /api/v1/payments/jazzcash/return
# ---------------------------------------------------------------------------
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=
JAZZCASH_CHECKOUT_URL=

# ---------------------------------------------------------------------------
# Optional KeyDB / Redis (MongoDB stays authoritative). Leave empty to disable.
# Use two instances/policies: cache = allkeys-lru, queue = noeviction.
# ---------------------------------------------------------------------------
CACHE_URL=
QUEUE_URL=

# Business timezone used for analytics/dashboard day boundaries
BUSINESS_TIMEZONE=Asia/Karachi

# ---------------------------------------------------------------------------
# Outgoing e-mail for password reset / password-changed notices.
# SMTP_HOST and EMAIL_FROM together or none; SMTP_USER and SMTP_PASS together or none.
# Without SMTP the reset link is only logged in development and nothing is sent in production.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=false          # defaults to true when SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Storefront page that accepts ?token=... (default: CLIENT_URL/reset-password)
# PASSWORD_RESET_URL=
# Admin dashboard page that accepts ?token=... (used for admin/staff accounts; falls back to PASSWORD_RESET_URL)
# ADMIN_PASSWORD_RESET_URL=

# ---------------------------------------------------------------------------
# One-off script inputs (pass on the command line, do NOT store in .env):
#   ADMIN_EMAIL ADMIN_PHONE ADMIN_NAME ADMIN_PASSWORD   -> npm run create-admin
# ---------------------------------------------------------------------------
