# Base path of the PEHANLY API as seen by the browser.
# Keep it relative ("/api/v1") so the HttpOnly session cookie stays same-origin
# (Vite proxies /api in development; your web server/reverse proxy does it in production).
VITE_API_BASE_URL=/api/v1

# Development only: where the backend listens (used by the Vite proxy, never shipped to the browser).
# The backend's CORS_ORIGINS must include http://localhost:3000 (the exact origin shown in the browser address
# bar) or every write request (register, login, ...) is rejected with 403 "Origin not allowed".
# The dev server uses a fixed port (strictPort): if 3000 is busy it stops instead of picking another port.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:5000

# Only needed if the SPA is served from a different origin than the API (not recommended with cookie sessions).
# VITE_API_BASE_URL=https://api.example.com/api/v1
