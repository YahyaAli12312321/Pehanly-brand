# Public, browser-visible settings ONLY. Never put secrets in VITE_* variables.

# Base URL of the PEHAN LY backend API (same backend the Admin Dashboard uses).
# Production (same origin behind a reverse proxy): /api/v1
# Production (separate API domain):               https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Canonical public URL of this website (used for canonicals, sitemap, JSON-LD).
VITE_SITE_URL=https://www.example.com

# WhatsApp number in international format without "+" (optional, enables chat links).
VITE_WHATSAPP_NUMBER=

# Dev only: where the Vite dev server proxies /api (not exposed to the browser).
# The dev server runs on http://localhost:3001 - that exact origin must be in the backend's CORS_ORIGINS.
DEV_API_PROXY=http://127.0.0.1:5000
